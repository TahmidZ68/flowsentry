# ============================================================
# FlowSentry Environment Configuration (Example)
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# Application
APP_NAME=FlowSentry
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & Encryption
# Generate with: python scripts/generate_keys.py
ENCRYPTION_KEY=replace-with-32-byte-urlsafe-base64-fernet-key
LOCAL_DEV_JWT_SECRET=replace-with-local-dev-only-secret-min-32-chars
ALLOW_PRIVATE_INTEGRATION_HOSTS=false

# Authentication
# Production: "supabase" | Local development/tests only: "local_dev"
AUTH_MODE=local_dev
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-optional-if-jwks-used

# Database & Redis
DATABASE_URL=postgresql+psycopg://flowsentry:flowsentry@postgres:5432/flowsentry
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AI Providers (Optional - deterministic fallback runs if unconfigured)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Notifications (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@flowsentry.local
SMTP_USE_TLS=true

# Frontend Public Variables (NEVER place secrets here)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AUTH_MODE=local_dev
