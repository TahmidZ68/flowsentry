# ============================================================
# FlowSentry Staging / Production Environment Template
# Copy to .env on the deployment host and replace placeholders.
# NEVER commit .env or .env.production to version control.
# ============================================================

# Application (set ENVIRONMENT=staging for staging, production for launch)
APP_NAME=FlowSentry
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=https://app.flowsentry.example

# Security & Encryption
# Generate ENCRYPTION_KEY with: python scripts/generate_keys.py
ENCRYPTION_KEY=replace-with-generated-32-byte-urlsafe-base64-fernet-key
# Leave blank in production (local_dev auth is rejected when ENVIRONMENT=production)
LOCAL_DEV_JWT_SECRET=
# Keep false unless n8n runs inside an explicit private VPC subnet
ALLOW_PRIVATE_INTEGRATION_HOSTS=false

# Supabase Cloud Authentication (Required when ENVIRONMENT=production)
AUTH_MODE=supabase
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_JWT_SECRET=

# Database & Redis
POSTGRES_USER=flowsentry
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=flowsentry
DATABASE_URL=postgresql+psycopg://flowsentry:replace-with-strong-postgres-password@postgres:5432/flowsentry
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:replace-with-strong-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-strong-redis-password@redis:6379/2

# AI Providers (Optional - deterministic rule-engine fallback runs if keys are unset)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# External SMTP Email Notifications (Optional)
# Use port 587 with SMTP_USE_TLS=true (STARTTLS) or port 465 with SMTP_USE_TLS=true (implicit SSL)
SMTP_HOST=smtp.provider.example
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=alerts@flowsentry.example
SMTP_USE_TLS=true

# Frontend Build-Time Public Variables (NEVER place secrets here)
# Leave NEXT_PUBLIC_API_URL empty for same-origin requests behind Nginx (/api/v1/...)
# OR set an explicit HTTPS API origin such as https://api.flowsentry.example
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_AUTH_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
